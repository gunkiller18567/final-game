[sub_resource type="GDScript" id="GDScript_0c6y7"]
script/source = "extends CharacterBody2D

@export var climbing = false
@onready var timer: Timer = $AnimationPlayer/Timer
@onready var asp = $AudioStreamPlayer
@onready var asp2 = $AudioStreamPlayer2
@onready var sprite = $alive
@onready var animation = $AnimationPlayer


var SPEED = 165.0
var JUMP_VELOCITY = -330.0
var gravity = 980
var fall = 16
var facing = \"r\"
var dead = false
var is_punching = false

func _physics_process(delta: float) -> void:

	if climbing == false:
		gravity = 980

	elif climbing == true:
		velocity.y = 0
		gravity = 0

		if Input.is_action_pressed(\"up\"):
			velocity.y = -SPEED

		elif Input.is_action_pressed(\"crouch\"):
			velocity.y = SPEED

	if not is_on_floor():
		velocity.y += gravity * delta

		if not is_punching:
			if velocity.y < 0:
				animation.play(\"jump\")
			if velocity.y > 0:
				animation.stop()
				animation.play(\"fall\")

	if is_on_floor():
		if velocity.y == 0 and not is_punching:
			animation.play(\"idle\")

		if Input.is_action_just_pressed(\"ko punch\") and not is_punching:
			trigger_ko_punch()

	if Input.is_anything_pressed() and not is_punching:
		animation.stop()
		timer.start(2.0)

	if Input.is_action_just_pressed(\"jump\") and is_on_floor() and not is_punching:
		velocity.y = JUMP_VELOCITY

	var direction := Input.get_axis(\"left\", \"right\")

	if direction and not is_punching:
		velocity.x = direction * SPEED
		if direction == -1.0 && dead == false:
			facing = \"left\"
		if direction == 1.0 && dead == false:
			facing = \"right\"

	if direction != 0 and not is_punching:
		sprite.flip_h = direction < 0
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)

	if Input.is_action_just_pressed(\"restart\"):
		get_tree().reload_current_scene()

	if is_on_floor() and not is_punching:
		if direction == 1.0:
			$CPUParticles2D.emitting = true
			$CPUParticles2D.direction.x = -1
		elif direction == -1.0:
			$CPUParticles2D.emitting = true
			$CPUParticles2D.direction.x = 1
		else:
			$CPUParticles2D.emitting = false
	else:
		$CPUParticles2D.emitting = false

	move_and_slide()

func _ready() -> void:
	timer.start(2.0)

func _on_timer_timeout() -> void:
	if not is_punching:
		print(\"pain\")
		animation.play(\"idle\")

func _on_trigger_area_entered(area: Area2D) -> void:
	if area.get_collision_layer_value(4):
		dead = true
		if facing == \"right\":
			$dead.modulate = Color(1, 1, 1, 1)
		if facing == \"left\":
			$dead2.modulate = Color(1, 1, 1, 1)
		$alive.modulate = Color(1, 1, 1, 0)
		$Label.modulate = Color(1, 1, 1, 1)
		$wit.modulate = Color(1, 1, 1, 0)
		$wic.modulate = Color(1, 1, 1, 0)
		$CPUParticles2D.modulate = Color(1, 1, 1, 0)
		SPEED = 0
		JUMP_VELOCITY = 0
		gravity = 980
		velocity = Vector2(0, 0)
		asp.play()

func trigger_ko_punch() -> void:
	is_punching = true

	if facing == \"left\":
		$kopunch.flip_h = true
	else:
		$kopunch.flip_h = false

	animation.play(\"ko punch\")

	asp2.play()

	for trans in range(11):
		$kopunch.modulate = Color(1, 1, 1, 1.0)
		await get_tree().create_timer(0.001).timeout
		if dead == true:
			if facing == \"right\":
				$dead.modulate = Color(1, 1, 1, 1)
			if facing == \"left\":
				$dead2.modulate = Color(1, 1, 1, 1)
				$alive.modulate = Color(1, 1, 1, 0)
				$Label.modulate = Color(1, 1, 1, 1)
				$wit.modulate = Color(1, 1, 1, 0)
				$wic.modulate = Color(1, 1, 1, 0)
				$CPUParticles2D.modulate = Color(1, 1, 1, 0)

	await get_tree().create_timer(1.5).timeout

	for trans in range(11):
		$kopunch.modulate = Color(1, 1, 1, (10 - trans) / 1.0)
		await get_tree().create_timer(0.05).timeout

	is_punching = false
"

