[sub_resource type="GDScript" id="GDScript_0c6y7"]
script/source = "extends CharacterBody2D

@export var climbing = false

var SPEED = 165.0
var JUMP_VELOCITY = -330.0
var gravity = 980
var fall = 16

@onready var asp = $AudioStreamPlayer
@onready var sprite = $alive

func _physics_process(delta: float) -> void:
	# Add the gravity.
	if climbing == false:
		gravity = 980
	elif climbing == true:
		velocity.y = 0
		gravity = 0
		if Input.is_action_pressed(\"up\"):
			velocity.y = -SPEED
		elif Input.is_action_pressed(\"crouch\"):
			velocity.y = SPEED
	if not is_on_floor():
		velocity.y += gravity * delta
	
	# Handle jump.
	if Input.is_action_just_pressed(\"jump\") and is_on_floor():
		velocity.y = JUMP_VELOCITY

	# Get the input direction and handle the movement/deceleration.
	# As good practice, you should replace UI actions with custom gameplay actions.
	var direction := Input.get_axis(\"left\", \"right\")
	
	
	
	if direction:
		print(direction)
		velocity.x = direction * SPEED
	if direction != 0:
		sprite.flip_h = direction < 0
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)
	
	if Input.is_action_just_pressed(\"restart\"):
		get_tree().reload_current_scene()
	
	
	if is_on_floor():
		if direction == 1.0:
			$CPUParticles2D.emitting = true
			$CPUParticles2D.direction.x = -1
		
		elif direction == -1.0:
			$CPUParticles2D.emitting = true
			$CPUParticles2D.direction.x = 1
		
		else:
			$CPUParticles2D.emitting = false
	else:
		$CPUParticles2D.emitting = false
	
	
	
	move_and_slide()


func _on_trigger_area_entered(area: Area2D) -> void:
	if area.get_collision_layer_value(4):
		if right:
			$dead.modulate = Color(1, 1, 1, 1)
		if left:
			$dead.modulate = Color(1, 1, 1, 0)
			$dead2.modulate = Color(1, 1, 1, 1)
		$alive.modulate = Color(1, 1, 1, 0)
		$dead.modulate = Color(1, 1, 1, 1)
		$Label.modulate = Color(1, 1, 1, 1)
		$wit.modulate = Color(1, 1, 1, 0)
		$wic.modulate = Color(1, 1, 1, 0)
		$CPUParticles2D.modulate = Color(1, 1, 1, 0)
		SPEED = 0
		JUMP_VELOCITY = 0
		gravity = 980
		velocity = Vector2(0, 0)
		asp.play()
		
"

